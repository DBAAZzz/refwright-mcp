{
  "name": "refwright-mcp",
  "version": "1.0.0",
  "description": "Fast, accurate browser automation MCP server: ref-based targeting, smart settle and incremental ARIA snapshots on Playwright.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "refwright-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
